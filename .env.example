# PostgreSQL (replace placeholders before deployment)
POSTGRES_USER=change_me
POSTGRES_PASSWORD=replace_with_a_long_random_password
POSTGRES_DB=n8n
POSTGRES_PORT=5432
POSTGRES_HOST=postgres

# Redis
REDIS_HOST=redis
QUEUE_MODE=redis

# n8n
N8N_PORT=5678
N8N_AUTH_ACTIVE=true
N8N_AUTH_USER=change_me
N8N_AUTH_PASS=replace_with_a_different_long_random_password
N8N_BASE_URL=https://n8n.yourdomain.com
N8N_WEBHOOK_URL=https://n8n.yourdomain.com

# WhatsApp MCP
MCP_PORT=8000
MCP_AUTH_USER=change_me
MCP_AUTH_PASS=replace_with_another_long_random_password
