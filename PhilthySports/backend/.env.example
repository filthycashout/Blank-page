# PhilthySports backend configuration.
# Keep real values in your deployment secret manager. Never commit them.

ODDS_API_KEY=
SPORTRADAR_API_KEY=
VISUAL_CROSSING_API_KEY=
GOOGLE_SHEETS_ID=
GCLOUD_PROJECT_ID=
GCLOUD_PRIVATE_KEY_ID=
GCLOUD_PRIVATE_KEY=
GCLOUD_CLIENT_EMAIL=
GCLOUD_CLIENT_ID=

# Optional service configuration
CACHE_TTL_SECONDS=300
# v6 production gates
CREDENTIAL_ROTATION_CONFIRMED=false
PREDICTION_LEDGER_PATH=/tmp/philthysports_prediction_ledger.jsonl
PHILTHY_ENGINE_MODE=market_baseline_only
PHILTHY_LIVE_ENABLED=false

ODDS_MAX_AGE_MINUTES=15
